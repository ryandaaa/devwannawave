{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "devwannawave",
  "version": "1.1.0",
  "identifier": "dev.wannawave.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "devwannawave",
        "width": 1000,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "decorations": false,
        "resizable": true,
        "backgroundColor": "#151518"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "windows/hooks.nsh",
        "startMenuFolder": "wannawave"
      }
    },
    "fileAssociations": [
      {
        "name": "Audio File",
        "description": "Open audio files with devwannawave",
        "ext": ["mp3", "flac", "wav", "ogg", "m4a", "aac", "opus"],
        "mimeType": "audio/*",
        "role": "Viewer"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
